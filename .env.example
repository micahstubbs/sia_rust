# sia_rust credentials — copy to `.env` and fill in real keys.
#
#   cp .env.example .env
#
# The real process environment ALWAYS wins: any variable already exported in
# your shell overrides the value here. `.env` is gitignored; never commit real
# keys. See docs/CREDENTIALS.md for which provider needs which key.
#
# These are PLACEHOLDERS ONLY — replace with your own keys.

# Anthropic (provider: anthropic; default meta/feedback agent + `claude` runner)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Optional: override the Anthropic base URL (e.g. a gateway/proxy).
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI (provider: openai; also the fallback when no provider is supplied)
OPENAI_API_KEY=your-openai-api-key-here

# Nebius Token Factory (provider: nebius; OpenAI-compatible)
# Base URL comes from the provider JSON, not an env var; for a different region
# create a custom provider JSON (see docs/NEBIUS_QUICKSTART.md).
NEBIUS_API_KEY=your-nebius-api-key-here

# Together AI (provider: together; OpenAI-compatible)
TOGETHER_API_KEY=your-together-api-key-here

# Google Gemini (provider: gemini)
GEMINI_API_KEY=your-gemini-api-key-here

# Tavily web search (optional; agent-ready web search — issue #106)
# Free tier: 1,000 credits/month. Get a key at https://app.tavily.com
TAVILY_API_KEY=your-tavily-api-key-here
